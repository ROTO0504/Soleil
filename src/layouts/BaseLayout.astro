---
import "@/styles/global.css";
import { SITE } from "@/config/site";
import Header from "@/components/Header.astro";
type Props = { title?: string; description?: string; image?: string; noindex?: boolean };
const { title, description = SITE.description, image = SITE.ogImage, noindex = false } = Astro.props;
const pageTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} | ${SITE.tagline}`;
const isHome = Astro.url.pathname === "/";
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---
<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f7f4ee" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={isHome ? "website" : "article"} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name} | ${SITE.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">本文へ移動</a>
    <Header />
    <main id="main"><slot /></main>
    <footer class="footer wrap">
      <a class="brand" href="/"> <span class="brand-symbol" aria-hidden="true"><i></i><i></i><i></i></span><span>{SITE.name}<small>VIOLIN · PIANO · SOLFÈGE</small></span></a>
      <p>{SITE.tagline}</p>
      <small>© {new Date().getFullYear()} {SITE.name}</small>
    </footer>
  </body>
</html>
