---
import { css } from "styled-system/css";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Not Found" noindex>
  <section class={css({ py: "16", textAlign: "center" })}>
    <h1 class={css({ fontSize: "4xl", fontWeight: "bold" })}>404</h1>
    <p class={css({ mt: "4" })}>ページが見つかりませんでした。</p>
    <a href="/" class={css({ display: "inline-block", mt: "6", color: "accent", fontWeight: "bold" })}>
      ホームへ戻る
    </a>
  </section>
</BaseLayout>
